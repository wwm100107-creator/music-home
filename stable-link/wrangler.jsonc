{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-home-link",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "LINK_STATE",
        "class_name": "LinkState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LinkState"]
    }
  ]
}
