# Copy to .env on the server and set the key from your Last.fm API account.
LASTFM_API_KEY=replace_with_your_lastfm_api_key

# Optional artwork provider. Fanart.tv lookups need MusicBrainz IDs resolved from release/artist metadata.
FANART_API_KEY=replace_with_your_fanart_api_key
# Optional personal Fanart.tv client key.
FANART_CLIENT_KEY=
